amends "https://sake92.github.io/deder/config/v0.20.0/DederProject.pkl"

import "../../resources/SqueryPlugin.pkl" as SQ

plugins {
  new SQ.SqueryPlugin {
    config = new {
      defaults = new {
        jdbcUrl = "jdbc:h2:mem:squery;DB_CLOSE_DELAY=-1;INIT=RUNSCRIPT FROM './schema.sql'"
        jdbcDeps { "com.h2database:h2:2.3.232" }
        schemaMappings { ["PUBLIC"] = "example" }
        includeTables { "PUBLIC\\.ACTOR" }
      }
    }
  }
}

modules {
  new ScalaModule {
    id = "consumer"
    root = "."
    scalaVersion = "3.7.4"
    deps {
      "ba.sake::squery:0.12.0"
      "com.h2database:h2:2.3.232"
    }
  }
}
