amends "https://sake92.github.io/deder/config/v0.21.1/DederProject.pkl"

import "../../resources/SqueryPlugin.pkl" as SQ

plugins {
  new SQ.SqueryPlugin {
    config = new {
      defaults = new {
        // Squery 0.13.0 requires Scala 3.9.0; this retained-Scala example uses 0.12.0.
        jdbcUrl = "jdbc:h2:mem:squery;DB_CLOSE_DELAY=-1;INIT=RUNSCRIPT FROM './schema.sql'"
        jdbcDeps { "com.h2database:h2:2.5.252" }
        schemaMappings { ["PUBLIC"] = "example" }
        includeTables { "PUBLIC\\.ACTOR" }
        squeryVersion = "0.12.0"
      }
    }
  }
}

modules {
  new ScalaModule {
    id = "consumer"
    root = "."
    scalaVersion = "3.7.4"
    deps {
      "ba.sake::squery:0.12.0"
      "com.h2database:h2:2.5.252"
    }
  }
}
