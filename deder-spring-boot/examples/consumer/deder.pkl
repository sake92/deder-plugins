amends "https://sake92.github.io/deder/config/v0.21.1/DederProject.pkl"

import "../../resources/SpringBootPlugin.pkl" as SB

plugins {
  new SB.SpringBootPlugin {
    version = "0.6.1-SNAPSHOT"
  }
}

modules {
  new JavaModule {
    id = "example"
    root = "."
    deps {
      "org.springframework.boot:spring-boot-starter:3.5.6"
    }
    mainClass = "example.Application"
  }
}
