module ba.sake.deder.plugins.springboot

import "https://sake92.github.io/deder/config-api/DederPlugins.pkl" as P

class SpringBootPlugin extends P.DederPlugin {
  id = "spring-boot"
  version: String = "0.6.0"
  deps {
    "ba.sake::deder-spring-boot:\(version)"
  }
  config: SpringBootPluginConfig = new {}
}

class SpringBootPluginConfig {
  defaults: ModuleDefaults = new {}
  modules: Mapping<String, ModuleOverride> = new Mapping {}
}

class ModuleDefaults {
  enabled: Boolean = true
  /// Spring Boot version, used to resolve `spring-boot-loader` (3.x only)
  springBootVersion: String = "3.5.6"
  /// Application main class, falls back to the module's main class
  mainClass: String? = null
  /// JVM options used by `springBootRun`
  jvmOptions: Listing<String> = new Listing {}
}

class ModuleOverride {
  enabled: Boolean? = null
  springBootVersion: String? = null
  mainClass: String? = null
  jvmOptions: Listing<String>? = null
}

config: SpringBootPluginConfig = new {}
