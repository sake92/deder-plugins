amends "https://sake92.github.io/deder/config/v0.21.1/DederProject.pkl"

local const versions = new {
  scala = "3.7.4"
  dederPluginApi = "0.21.1"
  munit = "1.3.6"
  sharaf = "0.19.0"
  tupson = "0.31.0"
  layoutz = "0.7.0"
}
local const publishRepo = if (read?("env:DEDER_PUBLISH_SNAPSHOT") == "true")
  new SonatypeSnapshotRepo { id = "sonatype" }
else
  new SonatypeCentralRepo { id = "sonatype" }

local const function pom(artId: String, artName: String, artDesc: String): PomSettings = new {
  groupId = "ba.sake"
  artifactId = artId
  name = artName
  description = artDesc
  url = "https://github.com/sake92/deder-plugins"
  licenses {
    new PomLicense {
      name = "Apache 2.0 License"
      url = "https://opensource.org/license/apache-2-0"
    }
  }
  developers {
    new PomDeveloper {
      id = "sake92"
      name = "Sakib Hadžiavdić"
      email = "sake92@sake.ba"
    }
  }
  scm {
    url = "https://github.com/sake92/deder-plugins"
    connection = "scm:git:git://github.com/sake92/deder-plugins.git"
  }
}

local const pluginModules =
  new CreateScalaModules {
    root = "deder-protobuf"
    id = "deder-protobuf"
    layout = "default"
    template = new ScalaModule {
      scalaVersion = versions.scala
      deps {
        "ba.sake::deder-plugin-api:\(versions.dederPluginApi)"
      }
      pomSettings =
        pom(
          "deder-protobuf",
          "Deder Protobuf Plugin",
          "Deder plugin for protobuf and gRPC code generation",
        )
      publish = true
      publishTo = publishRepo
    }
    testTemplate = (template.asTest()) {
      deps {
        "org.scalameta::munit:\(versions.munit)"
      }
    }
  }.get

local const buildInfoModules =
  new CreateScalaModules {
    root = "deder-build-info"
    id = "deder-build-info"
    layout = "default"
    template = new ScalaModule {
      scalaVersion = versions.scala
      deps {
        "ba.sake::deder-plugin-api:\(versions.dederPluginApi)"
      }
      pomSettings =
        pom(
          "deder-build-info",
          "Deder BuildInfo Plugin",
          "Deder plugin that generates a BuildInfo Scala object with build metadata constants",
        )
      publish = true
      publishTo = publishRepo
    }
    testTemplate = (template.asTest()) {
      deps {
        "org.scalameta::munit:\(versions.munit)"
      }
    }
  }.get

local const dashboardModules =
  new CreateScalaModules {
    root = "deder-web-dashboard"
    id = "deder-web-dashboard"
    layout = "default"
    template = new ScalaModule {
      scalaVersion = versions.scala
      scalacOptions { "-Yretain-trees" }
      deps {
        "ba.sake::deder-plugin-api:\(versions.dederPluginApi)"
        "ba.sake::sharaf-jdk-httpserver:\(versions.sharaf)"
      }
      pomSettings =
        pom(
          "deder-web-dashboard",
          "Deder Web Dashboard Plugin",
          "Deder plugin that starts a web dashboard showing module info and live server stats",
        )
      publish = true
      publishTo = publishRepo
    }
    testTemplate = (template.asTest()) {
      deps {
        "org.scalameta::munit:\(versions.munit)"
      }
    }
  }.get

local const tuiModules =
  new CreateScalaModules {
    root = "deder-tui-dashboard"
    id = "deder-tui-dashboard"
    layout = "default"
    template = new ScalaModule {
      scalaVersion = versions.scala
      deps {
        "ba.sake::tupson:\(versions.tupson)"
        "xyz.matthieucourt::layoutz:\(versions.layoutz)"
      }
      mainClass = "ba.sake.deder.tuidashboard.app.TuiDashboardMain"
      pomSettings =
        pom(
          "deder-tui-dashboard",
          "Deder TUI Dashboard",
          "CLI TUI dashboard for Deder live build stats"
        )
      publish = true
      publishTo = publishRepo
    }
    testTemplate = (template.asTest()) {
      deps {
        "org.scalameta::munit:\(versions.munit)"
      }
    }
  }.get

local const sourcegenModules =
  new CreateScalaModules {
    root = "deder-sourcegen"
    id = "deder-sourcegen"
    layout = "default"
    template = new ScalaModule {
      scalaVersion = versions.scala
      deps {
        "ba.sake::deder-plugin-api:\(versions.dederPluginApi)"
        "org.scala-lang::scala3-compiler:\(versions.scala)"
      }
      pomSettings =
        pom(
          "deder-sourcegen",
          "Deder Sourcegen Plugin",
          "Deder plugin for custom source code generation via user-written Scala scripts"
        )
      publish = true
      publishTo = publishRepo
    }
    testTemplate = (template.asTest()) {
      deps {
        "org.scalameta::munit:\(versions.munit)"
      }
    }
  }.get

local const squeryModules =
  new CreateScalaModules {
    root = "deder-squery"
    id = "deder-squery"
    layout = "default"
    template = new ScalaModule {
      scalaVersion = versions.scala
      deps {
        "ba.sake::deder-plugin-api:\(versions.dederPluginApi)"
      }
      pomSettings =
        pom(
          "deder-squery",
          "Deder Squery Plugin",
          "Deder plugin for Squery database model and DAO generation",
        )
      publish = true
      publishTo = publishRepo
    }
    testTemplate = (template.asTest()) {
      deps {
        "org.scalameta::munit:\(versions.munit)"
      }
    }
  }.get

local const openapi4sModules =
  new CreateScalaModules {
    root = "deder-openapi4s"
    id = "deder-openapi4s"
    layout = "default"
    template = new ScalaModule {
      scalaVersion = versions.scala
      deps {
        "ba.sake::deder-plugin-api:\(versions.dederPluginApi)"
      }
      pomSettings =
        pom(
          "deder-openapi4s",
          "Deder OpenAPI4s Plugin",
          "Deder plugin for editable Scala source generation with OpenAPI4s"
        )
      publish = true
      publishTo = publishRepo
    }
    testTemplate = (template.asTest()) {
      deps {
        "org.scalameta::munit:\(versions.munit)"
      }
    }
  }.get

modules {
  ...pluginModules.all
  ...buildInfoModules.all
  ...dashboardModules.all
  ...tuiModules.all
  ...sourcegenModules.all
  ...openapi4sModules.all
  ...squeryModules.all
}
